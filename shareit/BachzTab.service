[Unit]
Description=BachzTab Telegram Bot
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/BatchzBots/shareit
Environment=BACHZTAB_BOT_TOKEN=8987597971:AAFeZs-vbXcTcYAkFoMLAVhgdpVhq_60qyg
Environment=BACHZTAB_DB_PATH=/home/ubuntu/BatchzBots/shareit/bachztab.db
ExecStart=/home/ubuntu/BatchzBots/shareit/venv/bin/python3 -m bot.main
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
